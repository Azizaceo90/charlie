# ── Database (Postgres) ──────────────────────────────────────────────────────
# Paste your Postgres connection string. A free Neon database (neon.tech) works
# for both local development and production. It looks like:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign login session cookies. Set a long random string in
# production (e.g. `openssl rand -base64 32`). Changing it logs everyone out.
AUTH_SECRET=

# ── Email (optional, for employee invites) ───────────────────────────────────
# Connect Resend (resend.com) to email invites when you add an employee.
# Without it, the app still shows the credentials to share manually.
RESEND_API_KEY=
# Sender address. Use a verified domain to email external addresses; the
# default test sender only delivers to your own Resend account email.
EMAIL_FROM="Career Ops <onboarding@resend.dev>"

# ── Gmail integration (optional) ──────────────────────────────────────────────
# The Job Application Tracker reads your inbox to detect "Applied / Interview /
# Assessment / Offer" emails. Until these are set, the app shows sample data.
#
# How to get them:
#   1. Go to https://console.cloud.google.com/ and create a project.
#   2. Enable the "Gmail API".
#   3. Create an OAuth 2.0 Client ID (type: Web application).
#   4. Add this Authorized redirect URI:
#        http://localhost:3000/api/gmail/callback
#   5. Copy the Client ID + Client Secret below.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
