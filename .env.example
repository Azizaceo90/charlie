# ── Database (Postgres) ──────────────────────────────────────────────────────
# Paste your Postgres connection string. A free Neon database (neon.tech) works
# for both local development and production. It looks like:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign login session cookies. Set a long random string in
# production (e.g. `openssl rand -base64 32`). Changing it logs everyone out.
AUTH_SECRET=

# ── Email (optional, for employee invites & contracts) ───────────────────────
# Option A (recommended, no domain needed): send through your Gmail.
#   1. Turn on 2-Step Verification on your Google account.
#   2. Create an "App Password" (Google account → Security → App passwords).
#   3. Set the two values below. Emails send from your Gmail to anyone.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option B (alternative): Resend (resend.com). Needs a verified domain to email
# external addresses. Used only if the Gmail vars above are not set.
RESEND_API_KEY=
EMAIL_FROM="Career Ops <onboarding@resend.dev>"

# ── Job board APIs (optional) ────────────────────────────────────────────────
# Adzuna widens Job Search dramatically (US + Canada listings). Free for
# personal use. Sign up at https://developer.adzuna.com and paste both values:
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Gmail integration (optional) ──────────────────────────────────────────────
# The Job Application Tracker reads your inbox to detect "Applied / Interview /
# Assessment / Offer" emails. Until these are set, the app shows sample data.
#
# How to get them:
#   1. Go to https://console.cloud.google.com/ and create a project.
#   2. Enable the "Gmail API".
#   3. Create an OAuth 2.0 Client ID (type: Web application).
#   4. Add this Authorized redirect URI:
#        http://localhost:3000/api/gmail/callback
#   5. Copy the Client ID + Client Secret below.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
