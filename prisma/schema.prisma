// Prisma schema for Career Ops dashboard.
//
// Uses Postgres. For local development point DATABASE_URL at a Postgres
// instance (a free Neon database works for both local and production). The app
// auto-creates tables (`prisma db push` on deploy) and seeds sample data on
// first load. Enum-like fields are stored as strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  role         String // "admin" | "employee"
  title        String?
  avatarColor  String?
  passwordHash String?
  createdAt    DateTime @default(now())

  // Onboarding / personal info
  fullLegalName  String?
  dateOfBirth    DateTime?
  address        String?
  phone          String?
  emergencyName  String?
  emergencyPhone String?
  paymentMethod  String?
  paymentAccount String?
  onboardingDone Boolean   @default(false)
  // Default hourly pay rate (USD), used to pre-fill payroll runs.
  payRate        Float?
  // Comma-separated timesheet projects assigned to this employee. When set,
  // overrides the default project list derived from their title.
  projects       String?
  // Reusable "built-in" signature (base64 PNG data URL) the user can drop
  // onto any contract signature field instead of re-drawing it each time.
  signature      String?

  timeEntries   TimeEntry[]
  contracts     Contract[]     @relation("AssignedContracts")
  notifications Notification[]
  personalDocs  PersonalDoc[]
}

model PersonalDoc {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  category   String?
  fileName   String
  dataUrl    String
  sizeKb     Int
  uploadedAt DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "contract_assigned" | "contract_signed"
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model JobApplication {
  id           String   @id @default(cuid())
  company      String
  role         String
  status       String // applied | assessment | interview | offer | rejected
  date         DateTime
  source       String // gmail | manual
  emailSubject String?
  emailFrom    String?
  location     String?
  createdAt    DateTime @default(now())
}

model TimeEntry {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clockIn         DateTime
  clockOut        DateTime?
  project         String?
  note            String?
  chartsCoded     Int       @default(0)
  claimsProcessed Int       @default(0)
  submittedAt     DateTime?
  approvedAt      DateTime?
}

model SopDoc {
  id         String   @id @default(cuid())
  title      String
  category   String
  uploadedBy String
  uploadedAt DateTime @default(now())
  fileName   String
  dataUrl    String
  sizeKb     Int
}

model Contract {
  id               String    @id @default(cuid())
  title            String
  assignedToId     String
  assignedTo       User      @relation("AssignedContracts", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedToName   String
  status           String // pending | signed
  fileName         String
  dataUrl          String
  originalDataUrl  String?
  fields           String? // JSON array of fillable field placements
  issuedAt         DateTime  @default(now())
  signedAt         DateTime?
  remindedAt       DateTime? // last time a "please sign" reminder was emailed
  signatureDataUrl String?
  signerName       String?
}

model Applicant {
  id              String   @id @default(cuid())
  name            String
  email           String
  role            String
  stage           String // applied | screening | assessment | interview | offer | hired | rejected
  appliedAt       DateTime @default(now())
  rating          Int?
  location        String?
  phone           String?
  source          String? // "facebook" | "manual" | other
  facebookLeadId  String?  @unique
  formData        String?  // JSON of the raw lead form fields
}

model JobCache {
  id           String   @id @default(cuid())
  queryKey     String   @unique
  data         String // current snapshot (JSON jobs array)
  previousData String? // yesterday's snapshot, for "new since yesterday" diff
  fetchedAt    DateTime @default(now()) @updatedAt
}

model GmailToken {
  id         String    @id @default("default")
  tokens     String // JSON-encoded OAuth credentials
  email      String?
  lastSynced DateTime?
  updatedAt  DateTime  @updatedAt
}

model JobListing {
  id          String   @id @default(cuid())
  title       String
  company     String
  location    String
  type        String
  salary      String?
  postedAt    DateTime
  saved       Boolean  @default(false)
  applied     Boolean  @default(false)
  description String
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  userName    String
  date        DateTime
  category    String
  description String?
  amount      Float
  status      String   @default("pending") // pending | approved | reimbursed | rejected
  receiptUrl  String?  // base64 data URL of an uploaded receipt (PDF/image)
  receiptName String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model PayrollEntry {
  id          String    @id @default(cuid())
  userId      String
  userName    String
  periodStart DateTime
  periodEnd   DateTime
  hours       Float     @default(0)
  rate        Float     @default(0)
  gross       Float     @default(0)
  status      String    @default("pending") // pending | paid
  method      String?
  note        String?
  createdAt   DateTime  @default(now())
  paidAt      DateTime?

  @@index([userId])
}
